# ---- Airtable ----
# Personal Access Token with data.records:read + data.records:write on the base.
# Create at https://airtable.com/create/tokens
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
# The "Team Roadmap" base (already created for you)
AIRTABLE_BASE_ID=appTQYKyMR6Lm1TQM
# Table name (or table id tbl9nTusxo08W6z9L)
AIRTABLE_TABLE_NAME=Initiatives
# People directory table (assignee dropdown + GitHub login mapping). Default "People".
AIRTABLE_PEOPLE_TABLE=People

# ---- Slack ----
# Bot token (xoxb-...) for a Slack app with scopes:
#   chat:write, files:write, chat:write.public (or invite the bot to the channel),
#   im:write (for the weekly DM to the approver)
SLACK_BOT_TOKEN=xoxb-XXXXXXXXXXXX
# Channel the snapshot is posted to (#temp-roadmap)
SLACK_CHANNEL_ID=C0B9XRL15C2
# Person who reviews/approves the weekly draft (Amit). Used for the weekly DM.
SLACK_APPROVER_USER_ID=U0AUPLDPW8P

# ---- Clerk (auth — install from Vercel Marketplace or clerk.com) ----
# Vercel Marketplace auto-provisions these when you add the Clerk integration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXX
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# After sign-in, send users to the board.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
# Route Clerk through this app (required when using Vercel production keys).
# Also set the same proxy URL in Clerk Dashboard → Domains → Frontend API.
NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk
# In Clerk Dashboard → Restrictions, allow only: stasher.com
# For local dev, prefer pk_test_/sk_test_ keys (Clerk → API Keys → Development).

# ---- App ----
# Public URL of this deployment, used in Slack links (no trailing slash).
# On Vercel you can leave this blank and it will use VERCEL_URL.
APP_URL=
# Secret used to authenticate the weekly cron call. Set the same value in
# Vercel Project Settings -> Environment Variables and it is sent automatically
# by Vercel Cron as the Authorization: Bearer header.
CRON_SECRET=change-me-to-a-long-random-string

# ---- GitHub (optional: prefill initiatives from the Stashboard V2 project) ----
# Fine-grained PAT or org token with read access to the org's Projects v2 and
# the repos whose issues appear on the board. Permissions:
#   Organization -> Projects: Read-only
#   Repository   -> Issues: Read-only (for web, api, web-hosts, web-admin-dashboard,
#                   react-email-templates, dummy)
# Create at https://github.com/settings/tokens?type=beta and authorise it for
# the stasher-city org. If unset, the GitHub issue picker is simply hidden.
GITHUB_TOKEN=github_pat_XXXXXXXX
# Org login that owns the project (Stashboard V2 lives in stasher-city).
GITHUB_ORG=stasher-city
# Project number from the URL: github.com/orgs/stasher-city/projects/5
GITHUB_PROJECT_NUMBER=5
